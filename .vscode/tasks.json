{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build and Run Raylib Game",
            "command": "gcc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\game.exe",
                "-IC:/raylib/w64devkit/include",
                "-LC:/raylib/w64devkit/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                ";",
                "&",
                "${fileDirname}\\game.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}